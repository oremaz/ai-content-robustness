# Standalone GPU VM requirements.
# Install directly on Linux x86_64 GPU VMs with:
#   uv pip install -r requirements_gpu.in
#
# CUDA 12.4 wheels mirror the stage_orel_inria VM setup.
# Keep cuDNN/NCCL explicit: newer CUDA packages share the same nvidia/... paths
# and can overwrite the runtime used by these torch wheels.
--extra-index-url https://download.pytorch.org/whl/cu124
torch==2.6.0+cu124 ; sys_platform == "linux" and platform_machine == "x86_64"
torchvision==0.21.0+cu124 ; sys_platform == "linux" and platform_machine == "x86_64"
torchaudio==2.6.0+cu124 ; sys_platform == "linux" and platform_machine == "x86_64"
nvidia-cudnn-cu12==9.1.0.70 ; sys_platform == "linux" and platform_machine == "x86_64"
nvidia-nccl-cu12==2.21.5 ; sys_platform == "linux" and platform_machine == "x86_64"
bitsandbytes>=0.46.1 ; sys_platform == "linux" and platform_machine == "x86_64"

